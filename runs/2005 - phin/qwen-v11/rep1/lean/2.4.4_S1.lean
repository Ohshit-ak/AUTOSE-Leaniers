import ContractForge
open ContractForge

-- 2.4.4/S1: Reports generated by systems supporting OM should clearly indicate the number of cases, the number of contacts per case, the number of cases with no known epi-link at the time of diagnosis, the laboratory results, and the number of vaccinations and/or treatments administered.
-- compiles: False · rejects_bad_example: None · checked: False

structure Case where
  id         : Nat
  contacts   : Nat
  epiLink    : Bool
  laboratory : String
  vaccinations : Nat
  treatments : Nat
  deriving DecidableEq, Repr

structure Input where
  cases : List Case
  deriving DecidableEq, Repr

structure Output where
  report : String
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun i => i.cases.Nodup
  post := fun i o => o.report = i.cases.map (fun c =>
    s!"Case {c.id}: {c.contacts} contacts, {if ¬c.epiLink then "no known epi-link" else "known epi-link"}, laboratory results: {c.laboratory}, vaccinations: {c.vaccinations}, treatments: {c.treatments}")

example : Spec.pre { cases := [{ id := 1, contacts := 2, epiLink := false, laboratory := "positive", vaccinations := 1, treatments := 0 },
                                { id := 2, contacts := 0, epiLink := true, laboratory := "negative", vaccinations := 0, treatments := 1 }] } ∧
          Spec.post { cases := [{ id := 1, contacts := 2, epiLink := false, laboratory := "positive", vaccinations := 1, treatments := 0 },
                                 { id := 2, contacts := 0, epiLink := true, laboratory := "negative", vaccinations := 0, treatments := 1 }] }
                    { report := "Case 1: 2 contacts, no known epi-link, laboratory results: positive, vaccinations: 1, treatments: 0\nCase 2: 0 contacts, known epi-link, laboratory results: negative, vaccinations: 0, treatments: 1" } := by
  unfold Spec; decide
