import ContractForge
open ContractForge

-- 2.4.4/S1: Reports generated by systems supporting OM should clearly indicate the number of cases, the number of contacts per case, the number of cases with no known epi-link at the time of diagnosis, the laboratory results, and the number of vaccinations and/or treatments administered.
-- compiles: True · rejects_bad_example: None · checked: True

structure Case where
  id        : Nat
  contacts  : Nat
  epiLinks  : Nat
  labResults : String
  vaccinations : Nat
  treatments : Nat
  deriving DecidableEq, Repr

structure Input where
  cases : List Case
  deriving DecidableEq, Repr

structure Output where
  reports : List String
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun i => i.cases.Nodup
  post := fun i o => o.reports.length = i.cases.length ∧
                     ∀ c ∈ i.cases, o.reports.contains s!"Case {c.id}:
- Number of contacts: {c.contacts}
- Number of cases with no known epi-link at the time of diagnosis: {c.epiLinks}
- Laboratory results: {c.labResults}
- Number of vaccinations: {c.vaccinations}
- Number of treatments: {c.treatments}"

example : Spec.pre { cases := [{ id := 1, contacts := 2, epiLinks := 0, labResults := "positive", vaccinations := 1, treatments := 0 },
                                { id := 2, contacts := 0, epiLinks := 0, labResults := "negative", vaccinations := 0, treatments := 1 }] } ∧
          Spec.post { cases := [{ id := 1, contacts := 2, epiLinks := 0, labResults := "positive", vaccinations := 1, treatments := 0 },
                                 { id := 2, contacts := 0, epiLinks := 0, labResults := "negative", vaccinations := 0, treatments := 1 }] }
                    { reports := ["Case 1:
- Number of contacts: 2
- Number of cases with no known epi-link at the time of diagnosis: 0
- Laboratory results: positive
- Number of vaccinations: 1
- Number of treatments: 0", "Case 2:
- Number of contacts: 0
- Number of cases with no known epi-link at the time of diagnosis: 0
- Laboratory results: negative
- Number of vaccinations: 0
- Number of treatments: 1"] } := by
  set_option maxRecDepth 1000 in
  unfold Spec; decide
