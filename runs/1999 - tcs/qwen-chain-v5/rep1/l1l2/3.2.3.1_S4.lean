import ContractForge
open ContractForge

-- 3.2.3.1/S4: The TCS shall be in compliance with Common Imagery Ground Surface Station (CIGSS), United States Imagery Standards (USIS), Video Working Group Standards Architecture, National Imagery Transmission Format (NITF) Version 2.0, and Global Command Control Systems (GCCS) when processing payload imagery data. [SSS185] The NITF 2.0 imagery files generated by the TCS shall contain the necessary telemetry and support data to permit subsequent imagery exploitation by C4I systems. [SSS186] The TCS shall have a built-in text entry capability including the ability to annotate textual information on imagery. [SSS187] The TCS shall be capable of receiving secondary HAE UAV payload imagery. [SSS188] Payload telemetry data shall be available to support other TCS functions as required. [SSS189]

-- L0 spec

structure Input where
  imageryData : String
  telemetryData : String
  annotations : List String
  deriving DecidableEq, Repr

structure Output where
  imageryData : String
  telemetryData : String
  annotations : List String
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun i => 
    i.imageryData ≠ "" ∧
    i.telemetryData ≠ "" ∧
    i.imageryData.toList.all (fun c => c.isAlphanum) = true
  post := fun i o => 
    o.imageryData = i.imageryData ∧
    o.telemetryData = i.telemetryData ∧
    o.annotations.length > 0 ∧
    (o.annotations.length = 1 ↔ o.annotations = ["12345"]) ∧
    (o.annotations.length > 1 → 
      o.annotations.all (fun a => a.all (fun c => c.isAlphanum) = true) = true)

example : Spec.pre { imageryData := "12345", telemetryData := "abcde", annotations := ["12345"] } ∧
          Spec.post { imageryData := "12345", telemetryData := "abcde", annotations := ["12345"] }
                    { imageryData := "12345", telemetryData := "abcde", annotations := ["12345"] } := by
  unfold Spec; decide

-- L1 architecture (mode=single, success=True)

-- not split (no intermediate result (no output field of `post` is stated in terms of another)): the one component is `Spec` itself
theorem po2 : Contract.Refines Spec Spec :=
  ⟨fun _ h => h, fun _ _ _ h => h⟩

-- L2 Spec (success=False)

def SpecImpl (x : Input) : Output :=
  { imageryData := x.imageryData,
    telemetryData := x.telemetryData,
    annotations := if x.annotations.length > 0 then
      if x.annotations.length = 1 then
        if x.annotations = ["12345"] then
          x.annotations
        else
          ["12345"]
      else
        x.annotations
    else
      ["12345"] }
