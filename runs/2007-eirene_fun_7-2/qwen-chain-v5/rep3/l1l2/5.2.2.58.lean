import ContractForge
open ContractForge

-- 5.2.2.58: 5.2.2.58 An automatic confirmation shall be generated by the Cab radio at the end of the Railway emergency call as detailed in section 13. (M)

-- L0 spec

structure Input where
  callDuration : Nat
  emergencyCall : Bool
  deriving DecidableEq, Repr

structure Output where
  confirmed : Bool
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun i => i.emergencyCall = true
  post := fun i o => (o.confirmed = true ↔ i.callDuration > 5) ∧
                     (o.confirmed = false → i.callDuration ≤ 5)

example : Spec.pre { callDuration := 6, emergencyCall := true } ∧
          Spec.post { callDuration := 6, emergencyCall := true }
                    { confirmed := true } := by
  unfold Spec; decide

-- L1 architecture (mode=single, success=True)

-- not split (no intermediate result (no output field of `post` is stated in terms of another)): the one component is `Spec` itself
theorem po2 : Contract.Refines Spec Spec :=
  ⟨fun _ h => h, fun _ _ _ h => h⟩

-- L2 Spec (success=True)

def SpecImpl (x : Input) : Output :=
  { confirmed := decide (x.callDuration > 5) }

theorem SpecImpl_ok : Spec.Satisfies SpecImpl := by
  discharge_po3 [Spec, SpecImpl]

-- end to end (checked=True)

theorem system_ok : Spec.Satisfies SpecImpl :=
  Contract.refines_sound po2 SpecImpl_ok
