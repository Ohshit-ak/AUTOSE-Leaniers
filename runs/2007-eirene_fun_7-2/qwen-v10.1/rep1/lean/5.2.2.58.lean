import ContractForge
open ContractForge

-- 5.2.2.58: 5.2.2.58 An automatic confirmation shall be generated by the Cab radio at the end of the Railway emergency call as detailed in section 13. (M)
-- compiles: True · rejects_bad_example: True · checked: True

structure Input where
  callDuration : Nat
  deriving DecidableEq, Repr

structure Output where
  confirmationGenerated : Bool
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun i => i.callDuration > 5
  post := fun i o => o.confirmationGenerated = true

example : Spec.pre { callDuration := 6 } ∧
          Spec.post { callDuration := 6 } { confirmationGenerated := true } := by
  unfold Spec; decide
