import ContractForge
open ContractForge

-- 8.2.3/S1: In order to minimise the discomfort caused by the DTMF tone added in the voice channel, the duration of the tone generated by the fixed line dispatcher shall be 70ms ± 5ms, and there shall be a minimum gap of 65ms between each tone.
-- compiles: False · rejects_bad_example: None · checked: False

structure Input where
  deriving DecidableEq, Repr

structure Output where
  elapsedMicros : Nat
  duration      : Nat
  gap           : Nat
  deriving DecidableEq, Repr

def Spec : Contract Input Output where
  pre  := fun _ => True
  post := fun _ o => o.duration ≤ 70 ∧ o.duration ≥ 65 ∧
                     o.gap ≥ 65 ∧ o.gap ≤ 70 ∧
                     o.elapsedMicros ≤ 70000 ∧
                     o.elapsedMicros ≤ 5000 ∧
                     o.elapsedMicros ≤ 65000

example : Spec.pre { duration := 68, gap := 66 } ∧
          Spec.post { duration := 68, gap := 66, elapsedMicros := 67000 }
                    { duration := 68, gap := 66, elapsedMicros := 67000 } := by
  unfold Spec; decide
