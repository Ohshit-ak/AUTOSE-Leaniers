-- 3.1.3/S1: Customers will be able to create accounts to store their customer profiles, configure contact information, view their purchase history, and confirm orders.
-- checked: None

```lean
structure CustomerProfile where
  name : String
  contactInfo : String
  purchaseHistory : List String
  confirmedOrders : List String

structure Account where
  profile : CustomerProfile
  created : Bool := false

structure Input where
  createAccount : Option Account
  configureContact : Option String
  viewPurchaseHistory : Option String
  confirmOrder : Option String

structure Output where
  account : Option Account
  contactInfo : Option String
  purchaseHistory : Option String
  confirmedOrders : Option String

def Spec : Contract Input Output where
  pre input := do
    match input.createAccount with
    | some account => account.created
    | none        => true
  post input output := do
    match input.createAccount with
    | some account =>
      output.account = some account ∧
      account.created = true ∧
      output.contactInfo = some account.profile.contactInfo ∧
      output.purchaseHistory = some account.profile.purchaseHistory ∧
      output.confirmedOrders = some account.profile.confirmedOrders
    | none =>
      output.account = none ∧
      output.contactInfo = none ∧
      output.purchaseHistory = none ∧
      output.confirmedOrders = none

