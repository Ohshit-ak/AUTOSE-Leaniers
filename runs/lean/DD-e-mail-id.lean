-- DD-e-mail-id: E-mail address of the customer who is using the Web order system; 50 characters alphanumeric
-- checked: None

```lean
structure Contract (α : Type) where
  pre  : α → Prop
  post : α → Prop

def EMailId : Type := String

def isAlphanumeric (s : String) : Bool :=
  s.forall (λ c, c.isDigit ∨ c.isLower ∨ c.isUpper)

def validEMailId (s : EMailId) : Prop :=
  s.length = 50 ∧ isAlphanumeric s

def Spec : Contract EMailId Unit :=
  { pre := λ s, s.length ≤ 50 ∧ isAlphanumeric s,
    post := λ s _, validEMailId s }

example : Spec.pre "
